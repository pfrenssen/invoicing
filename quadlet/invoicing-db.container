[Unit]
Description=MariaDB database of Invoicing

[Container]
ContainerName=invoicing-db
Image=docker.io/library/mariadb:11.8
Environment=MARIADB_DATABASE=invoicing
Environment=MARIADB_USER=invoicing
Environment=MARIADB_PASSWORD_FILE=/run/secrets/db_password
Environment=MARIADB_ROOT_PASSWORD_FILE=/run/secrets/db_root_password
Secret=invoicing-db-password,target=db_password
Secret=invoicing-db-root-password,target=db_root_password
Network=invoicing.network
# The Invoicing container connects to the host name "db".
NetworkAlias=db
Volume=invoicing-db.volume:/var/lib/mysql
# Limit the damage of a compromise. The only writable paths are the volume and
# the tmpfs mounts: /tmp for temporary tables, /run for the socket and the pid
# file of mysqld.
DropCapability=ALL
AddCapability=SETUID SETGID DAC_READ_SEARCH
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,size=128m
Tmpfs=/run:noexec,size=8m
# Measured under load: 210 MB and 24 threads, with the default InnoDB buffer
# pool of 128 MB. The tmpfs mounts count as memory too.
Memory=512M
PidsLimit=128
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
# systemd counts the unit as started when the health check passes, so the
# Invoicing container is started after the database accepts connections.
Notify=healthy
# Drupal 7 uses utf8mb4 with utf8mb4_general_ci.
Exec=--character-set-server=utf8mb4 --collation-server=utf8mb4_general_ci

[Service]
Restart=on-failure
# The first start downloads the image, which has to fit in this time.
TimeoutStartSec=900
