# Copy this file to
# ~/.config/containers/systemd/invoicing.container.d/settings.conf
# and remove the "#" of the settings to change. Then run
# "systemctl --user daemon-reload".

[Container]
# Publish the web server on another address or port. The empty line removes
# the default, which is 127.0.0.1:8797.
#PublishPort=
#PublishPort=127.0.0.1:8797:80
