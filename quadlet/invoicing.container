[Unit]
Description=Invoicing
Requires=invoicing-db.container
After=invoicing-db.container

[Container]
ContainerName=invoicing
Image=invoicing.build
# Loopback only by default: the container serves HTTP without TLS, and runs a
# Drupal 7 site on a PHP version that no longer receives security fixes.
PublishPort=127.0.0.1:8797:80
Secret=invoicing-db-password,target=db_password
Secret=invoicing-hash-salt,target=hash_salt
Network=invoicing.network
Volume=invoicing-files.volume:/var/www/build/sites/default/files
# Limit the damage of a compromise. The only writable paths are the volume and
# the tmpfs mounts: /tmp for PHP and Drupal, /run for the pid files and the
# temporary files of nginx.
DropCapability=ALL
AddCapability=CHOWN SETGID SETUID NET_BIND_SERVICE
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,size=16m
# Empty at each start: without notmpcopyup, podman copies /run of the image into
# the tmpfs, with /run/nginx owned by the user nginx.
Tmpfs=/run:noexec,notmpcopyup,size=64m
# Measured without the page cache, with one user, a cache rebuild and a restore:
# 87 MB and 10 processes; 148 MB under sustained parallel load. A PHP request
# may use up to memory_limit (128M); the tmpfs mounts count as memory too.
Memory=192M
PidsLimit=64
HealthCmd=healthcheck.sh
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
# systemd counts the unit as started when the health check passes.
Notify=healthy

[Service]
Restart=on-failure
# The first start builds the image, which downloads Drupal and its modules.
TimeoutStartSec=1800

[Install]
WantedBy=default.target
